# === Sage environment ===

# App metadata
APP_NAME=Sage
APP_VERSION=1.0.0
ENVIRONMENT=development

# Database. SQLite for dev; use a Postgres URL in production.
#   dev:   sqlite:///./sage.db
#   prod:  postgresql+psycopg2://user:pass@host:5432/sage
DATABASE_URL=sqlite:///./sage.db

# JWT signing. Set a long random string in production (e.g. `openssl rand -hex 32`).
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Uploads
MAX_UPLOAD_BYTES=20971520
ALLOWED_EXTENSIONS=.txt,.md,.pdf

# Rate limiting
RATE_LIMIT=100/minute

# CORS (comma-separated origins; * for open)
CORS_ORIGINS=*
